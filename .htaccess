# Habilitar RewriteEngine
RewriteBase /
RewriteEngine On

# Redirección de HTTP a HTTPS
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://www.canales.pe/$1 [R,L]

RewriteCond %{REQUEST_URI} [A-Z]
RewriteRule (.*) ${lowercase:$1} [R=301,L]


# Reescritura de URLs para archivos HTML y PHP
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Deshabilitar la lista de directorios
Options All -Indexes

# Configuración de páginas de error personalizadas
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html

# Proteger el archivo .htaccess y otros archivos de configuración
<FilesMatch "^\.ht.*">
    Order allow,deny
    Deny from all
    Satisfy All
</FilesMatch>
